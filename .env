# docker-compose variable substitution — NON-SECRET, committed.
# Actual secrets live in secrets/vps.env (gitignored, sops-encrypted as vps.env.enc).
#
# Image version pins. sing-box is config-format-coupled: this repo's config targets the
# sing-box 1.12+ schema (typed DNS servers, domain resolvers, rule actions, certificate
# providers) and is validated against exactly this version by vps/bootstrap.sh and
# scripts/test-configs.sh. Bump it here only; both pick it up. Verify the tag exists at
# https://github.com/SagerNet/sing-box/releases and read README "Version pinning" first.
# On this VPS a 1.11.14 server rejected every Reality client we have (measured 2026-10-19);
# v1.14.3 does not. Do not go back.

SINGBOX_VERSION=v1.14.3
TAILSCALE_VERSION=stable
NETDATA_VERSION=stable
UPTIMEKUMA_VERSION=1
VNSTAT_VERSION=latest

# Primary public network interface name on the VPS (for vnStat accounting).
# Find it with:  ip route get 1.1.1.1 | awk '{print $5; exit}'
VPS_IFACE=eth0

# Tailscale hostname for the VPS node. Region-neutral — the system works in ANY region
# (Tokyo, US-West, Singapore...). Set this to match wherever you actually deploy,
# e.g. tokyo-vps, lax-vps, sg-vps. Used only as the Tailscale machine name.
VPS_HOSTNAME=cbn-vps
