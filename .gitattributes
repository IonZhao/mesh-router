# This repo is deployed on Linux (VPS) and macOS (Mac mini). Force LF on checkout
# everywhere so shell scripts never get CRLF (which breaks bash with $'\r' errors),
# regardless of the cloner's core.autocrlf setting.
* text=auto eol=lf

*.sh        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.template  text eol=lf
*.plist     text eol=lf
*.md        text eol=lf
*.html      text eol=lf
*.env       text eol=lf
*.example   text eol=lf
